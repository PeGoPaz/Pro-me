# Environment variables
.env
.env.local
.env.*.local

# Dependencies. The package-lock.json files are committed: they pin every
# transitive version, so CI, Render and a fresh clone install the same tree.
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# IDE & OS
.DS_Store
# macOS writes these AppleDouble sidecars next to every file on ExFAT/FAT
# drives (and network shares). Junk to git; never commit them.
._*
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Project artifacts
demo.mp4

# Local editor and assistant settings
.claude/
