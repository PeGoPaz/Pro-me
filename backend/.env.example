# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/prome

# Session secret - MUST be a long, random string in production.
# On Render this is generated automatically (see render.yaml).
# Generate locally with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Extra allowed origins, comma-separated. Usually NOT needed:
#   - in production the frontend is served by this same app, so requests are
#     same-origin and always allowed (Render's RENDER_EXTERNAL_URL is added
#     automatically too);
#   - in development localhost:5173 and :3000 are allowed by default.
# Only set this if you serve the frontend from a different host.
# CLIENT_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# SameSite policy for the session cookie. Leave unset: the default is "lax",
# which is correct because the cookie is first-party.
#   none -> only if the frontend moves to a different site again. Forces
#           Secure, and Safari/iOS will still block it as a third-party cookie.
# COOKIE_SAMESITE=lax

# Number of reverse-proxy hops in front of the app. Defaults to 1 in
# production (Render's load balancer) and 0 in development. Wrong values break
# the Secure session cookie and make rate limits shared between visitors.
# TRUST_PROXY=1

# Cloudinary, for avatars and instructors' gallery photos: the "API environment variable"
# from the Cloudinary console, cloudinary://<key>:<secret>@<cloud name>.
# Without it the app runs, and photo uploads answer 503.
# CLOUDINARY_URL=

# Environment
NODE_ENV=development

# Server port
PORT=9000
