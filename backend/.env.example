# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/prome

# Session secret - MUST be a long, random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Client origin - comma-separated list of allowed origins.
# This is not just CORS hygiene: with cross-site cookies (see COOKIE_SAMESITE)
# this allowlist is what stands between the session cookie and CSRF, so keep it
# exact. No trailing slashes, no wildcards.
# Example: CLIENT_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# SameSite policy for the session cookie. Leave unset unless you know you need it.
#   unset  -> "lax" in development, "none" in production
#   none   -> required when the frontend and API are on DIFFERENT registrable
#             domains, which is the case for the default Render setup
#             (pro-me-frontend.onrender.com vs pro-me-backend.onrender.com).
#             Without it the browser drops the cookie on every API call and
#             login silently fails. Forces Secure, so it needs HTTPS.
#   strict -> safer. Use it once the frontend and API share one registrable
#             domain, e.g. app.example.ie and api.example.ie.
# COOKIE_SAMESITE=strict

# Environment
NODE_ENV=development

# Server port
PORT=9000
